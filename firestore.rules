rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // A revoked realtor keeps their marker doc with active == false (the
    // client SDK cannot delete their Auth account), so check the flag too.
    // Docs without the field predate revocation and count as active.
    function isRealtor() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/realtors/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/realtors/$(request.auth.uid)).data.get('active', true) == true;
    }

    // Public site content: readable by anyone, editable only by admin.
    match /content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public photo gallery metadata: same pattern as content.
    match /gallery/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Library documents: admin sees everything; a realtor sees only docs
    // marked visibility=='realtor'. Writes (including creating an
    // admin-visibility doc) are admin-only.
    //
    // IMPORTANT for list/collection queries (getDocs(query(...))): Firestore
    // evaluates the rule against every document a query COULD return, not
    // just the ones it does return — it denies the whole query up front if
    // it cannot prove every possible match satisfies the rule, rather than
    // filtering out disallowed documents. A realtor-facing query against
    // this collection MUST therefore include a matching
    // where('visibility', '==', 'realtor') clause, or the entire query will
    // be denied. See tests/rules/firestore.test.js for coverage of this.
    match /documents/{docId} {
      allow read: if isAdmin() || (isRealtor() && resource.data.visibility == 'realtor');
      allow write: if isAdmin();
    }

    // Admins: readable by any signed-in user (needed for isAdmin()-style
    // checks client-side). Writes are admin-only — the FIRST admin doc must
    // be created in the Firebase Console, which bypasses rules.
    match /admins/{uid} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Realtors: a realtor can read their own marker doc (to resolve their
    // own role); admin can read/write any. No self-write: accounts are
    // provisioned by an admin on the Realtor Access page (or via
    // scripts/create-realtor.mjs).
    match /realtors/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // Realtor access requests from the public Realtors tab. Keyed by the
    // (lowercased) email so repeat requests don't pile up: a second create for
    // the same email is an update, which is denied. Only the exact shape the
    // form sends is accepted; admin reads them and deletes on grant/decline.
    // Size limits must match src/realtorAccess.js.
    match /accessRequests/{email} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'requestedAt']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 100 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 254 &&
        request.resource.data.email == email &&
        request.resource.data.email == email.lower() &&
        request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$') &&
        request.resource.data.requestedAt == request.time;
      allow read, delete: if isAdmin();
    }
  }
}
