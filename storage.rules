rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // These firestore.exists() checks are cross-service rules: the Storage
    // service agent needs roles/firebaserules.firestoreServiceAgent or every
    // check fails and all writes are denied. `firebase deploy` only grants it
    // when run interactively (no TTY or an AI-agent shell counts as
    // non-interactive; `--interactive --force` overrides), and only when these
    // rules have changed since the last deploy.
    function isAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Mirrors isRealtor() in firestore.rules: a revoked realtor has active == false.
    function isRealtor() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/realtors/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/realtors/$(request.auth.uid)).data.get('active', true) == true;
    }

    match /gallery/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /documents/realtor/{fileName} {
      allow read: if isAdmin() || isRealtor();
      allow write: if isAdmin();
    }

    match /documents/admin/{fileName} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
